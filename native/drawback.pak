compressed=8192
crc32=0x3E7A1FC9
flags=0x01
data=
#version 420 core
layout(location = 0) in vec2 position;
layout(location = 1) in vec2 texCoord;

out vec2 TexCoord;

uniform mat4 projection;
uniform float blur_strength;

void main()
{
    gl_Position = projection * vec4(position, 0.0, 1.0);
    TexCoord = texCoord * blur_strength;
}

