data=
[system]
os_version=2.1.0
os_name=WindowsMediaCentreTV
ui_mode=medcen
theme=glass_panel
language=en

[display]
resolution=1920x1080
refresh_rate=60
overscan=10
glass_effect=enabled
tv_safe_area=true

[renderer]
engine=wmctv_chromium
hardware_accel=true
vsync=true

[web_import]
cache_dir=/var/wmctv/cache
max_cache=2147483648
cache_ttl=3600
concurrent_imports=4
supported_protocols=http,https

[network]
timeout_connect=10000
timeout_read=30000
use_system_proxy=true

[security]
sandbox_mode=strict
verify_certificates=true
allow_insecure=false

[remote_control]
protocol=ir
key_repeat_delay=500
key_repeat_rate=100

