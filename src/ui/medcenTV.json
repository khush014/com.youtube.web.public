const { ipcRenderer } = require('electron');
const config = require('../isexpect.json');

class centv {
  constructor() {
    this.config = config;
    this.currentChannel = null;
    this.playbackState = 'stopped';
    this.libraryPath = config.mediaCenter.libraryPath;
    this.supportedFormats = config.mediaCenter.supportedFormats;
    this.importQueue = [];
    this.metadata = {};
    this.init();
  }

  init() {
    this.setupEventListeners();
    this.loadLibrary();
    this.initializeUI();
    this.startGuideProvider();
  }

  setupEventListeners() {
    document.addEventListener('keydown', (e) => this.handleRemoteInput(e));
    ipcRenderer.on('media-ready', () => this.onMediaReady());
    ipcRenderer.on('import-progress', (event, data) => this.updateImportProgress(data));
  }

  loadLibrary() {
    ipcRenderer.send('fetch-library', {
      path: this.libraryPath,
      formats: this.supportedFormats
    });
  }

  initializeUI() {
    this.container = document.getElementById('media-center-container');
    this.createGlassPanel();
    this.renderChannelGrid();
    this.setupNavigationController();
  }

  createGlassPanel() {
    const panel = document.createElement('div');
    panel.className = 'glass-panel';
    panel.style.cssText = `
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 20px;
      margin: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    `;
    this.container.appendChild(panel);
    this.glassPanel = panel;
  }

  renderChannelGrid() {
    const grid = document.createElement('div');
    grid.className = 'channel-grid';
    grid.style.cssText = `
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      padding: 20px;
    `;

    for (let i = 1; i <= 16; i++) {
      const tile = this.createChannelTile(i);
      grid.appendChild(tile);
    }

    this.glassPanel.appendChild(grid);
    this.channelGrid = grid;
  }

  createChannelTile(channelNumber) {
    const tile = document.createElement('div');
    tile.className = 'channel-tile';
    tile.dataset.channel = channelNumber;
    tile.style.cssText = `
      background: rgba(50, 50, 50, 0.3);
      border: 2px solid rgba(100, 180, 255, 0.5);
      border-radius: 10px;
      padding: 15px;
      cursor: pointer;
      transition: all 0.3s ease;
      aspect-ratio: 16 / 9;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    `;

    tile.innerHTML = `
      <div style="color: #64b4ff; font-weight: bold; font-size: 18px;">
        CH ${channelNumber}
      </div>
      <div style="color: #ddd; font-size: 12px;">
        Program ${channelNumber}
      </div>
      <div style="color: #999; font-size: 10px;">
        ${Math.floor(Math.random() * 120)}min
      </div>
    `;

    tile.addEventListener('click', () => this.selectChannel(channelNumber));
    tile.addEventListener('mouseenter', () => this.hoverChannel(tile));
    tile.addEventListener('mouseleave', () => this.unhoverChannel(tile));

    return tile;
  }

  selectChannel(channelNumber) {
    this.currentChannel = channelNumber;
    this.playbackState = 'playing';
    this.updateChannelDisplay();
    ipcRenderer.send('play-channel', { channel: channelNumber });
  }

  hoverChannel(tile) {
    tile.style.transform = 'scale(1.05)';
    tile.style.boxShadow = '0 0 20px rgba(100, 180, 255, 0.8)';
  }

  unhoverChannel(tile) {
    tile.style.transform = 'scale(1)';
    tile.style.boxShadow = 'none';
  }

  updateChannelDisplay() {
    const tiles = this.channelGrid.querySelectorAll('.channel-tile');
    tiles.forEach(tile => {
      if (parseInt(tile.dataset.channel) === this.currentChannel) {
        tile.style.borderColor = 'rgba(100, 220, 100, 0.8)';
        tile.style.backgroundColor = 'rgba(0, 100, 0, 0.2)';
      } else {
        tile.style.borderColor = 'rgba(100, 180, 255, 0.5)';
        tile.style.backgroundColor = 'rgba(50, 50, 50, 0.3)';
      }
    });
  }

  setupNavigationController() {
    this.navController = {
      up: () => this.navigateGrid('up'),
      down: () => this.navigateGrid('down'),
      left: () => this.navigateGrid('left'),
      right: () => this.navigateGrid('right'),
      select: () => this.confirmSelection()
    };
  }

  handleRemoteInput(event) {
    const keyMap = {
      'ArrowUp': 'up',
      'ArrowDown': 'down',
      'ArrowLeft': 'left',
      'ArrowRight': 'right',
      'Enter': 'select'
    };

    if (keyMap[event.key]) {
      this.navController[keyMap[event.key]]();
    }
  }

  navigateGrid(direction) {
    // Grid navigation logic for TV remote
    console.log(`Navigate ${direction}`);
  }

  startGuideProvider() {
    setInterval(() => {
      this.updateProgramGuide();
    }, 5000);
  }

  updateProgramGuide() {
    ipcRenderer.send('fetch-guide-data', {
      channels: Array.from({length: 16}, (_, i) => i + 1)
    });
  }

  updateImportProgress(data) {
    console.log(`Importing: ${data.filename} - ${data.progress}%`);
    this.importQueue.push(data);

    if (this.importQueue.length > config.importConfig.maxConcurrentImports) {
      this.processImportQueue();
    }
  }

  processImportQueue() {
    const batch = this.importQueue.splice(0, config.importConfig.maxConcurrentImports);
    batch.forEach(item => {
      ipcRenderer.send('import-media', {
        file: item.path,
        validateMetadata: config.importConfig.validateMetadata,
        chunkSize: config.middleware.fileHandling.chunkSize
      });
    });
  }

  onMediaReady() {
    console.log('Media library ready');
    this.loadLibrary();
  }
}

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', () => {
  window.mediaCenter = new MedterTV();
});

module.exports = no;
